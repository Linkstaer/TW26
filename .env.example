# ---- Django ----
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=False
DEV=False
ALLOWED_HOSTS=tu-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://tu-app.up.railway.app

# ---- Base de datos ----
# En Railway se inyecta sola al vincular el servicio Postgres:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Si no esta definida, Django cae a SQLite (solo desarrollo).
DATABASE_URL=

# ---- Admin de emergencia (opcional) ----
# Crea/actualiza un superusuario con roblox_id=1 en cada arranque.
EMERGENCY_ADMIN_USERNAME=
EMERGENCY_ADMIN_PASSWORD=

# ---- OAuth de Roblox ----
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=https://tu-app.up.railway.app/accounts/login/roblox/callback/

# ---- IA (opcional, core/api/ai.py) ----
ANTHROPIC_API_KEY=
